# Dockerfile para entorno de ejecución de MCPs de IA con Python
FROM python:3.10-slim

# Actualizar repositorios e instalar dependencias necesarias para compilación
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Establecer el directorio de trabajo para los scripts y archivos MCP
WORKDIR /mcp

# Variable de entorno para indicar que estamos en un entorno de ejecución MCP
ENV MCP_ENVIRONMENT=true

# Crear un script de punto de entrada que muestre cómo instalar paquetes
RUN echo '#!/bin/bash\necho "Para instalar paquetes de IA, use:"\necho "pip install <nombre-del-paquete>"\necho "Ejemplo: pip install tensorflow torch transformers"\necho ""\nexec "$@"' > /entrypoint.sh && \
    chmod +x /entrypoint.sh

# Establecer el script como punto de entrada
ENTRYPOINT ["/entrypoint.sh"]

# Comando por defecto para ejecutar Python
CMD ["python"]