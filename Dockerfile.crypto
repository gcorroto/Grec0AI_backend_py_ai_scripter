# Dockerfile para análisis de criptomonedas y finanzas
FROM python:3.9-slim

# Instalar dependencias del sistema
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Librerías para análisis financiero y cripto
RUN pip install --no-cache-dir \
    ccxt \
    yfinance \
    pandas-ta \
    ta \
    alpha-vantage \
    cryptocompare \
    python-binance \
    coinbasepro \
    web3 \
    eth-account \
    pandas \
    numpy \
    scipy \
    matplotlib \
    seaborn \
    plotly \
    mplfinance \
    backtrader \
    zipline-reloaded \
    quantlib

WORKDIR /scripts
CMD ["python"]
