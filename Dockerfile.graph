# Dockerfile para generar imágenes de gráficas (py-graph)
FROM python:3.9-slim

# Actualizar repositorios e instalar dependencias básicas
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    graphviz \
    && rm -rf /var/lib/apt/lists/*

# Instalar librerías de Python para generación de gráficos y análisis
RUN pip install --no-cache-dir \
    numpy \
    pandas \
    matplotlib \
    seaborn \
    plotly \
    bokeh \
    pillow \
    graphviz \
    scipy \
    networkx \
    scikit-learn \
    statsmodels

# Establecer el directorio de trabajo
WORKDIR /scripts

# Comando por defecto (se puede sobrescribir en tiempo de ejecución)
CMD ["python"]
